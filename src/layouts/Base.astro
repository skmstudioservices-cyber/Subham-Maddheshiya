---
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const person = { "@context":"https://schema.org", "@type":"Person", name:"Subham Maddheshiya", url:"https://subhammaddheshiya.pages.dev/", jobTitle:"Independent Web Product Builder", knowsAbout:["Search engine optimization","Web development","Digital products","Public data","Website design"], worksFor:{"@type":"Organization",name:"SKM Studio",url:"https://skmstudio.pages.dev/"} };
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="color-scheme" content="light" />
<title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={canonical} /><meta name="theme-color" content="#f5f6f2" />
<meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="profile" /><meta property="og:url" content={canonical} /><meta name="twitter:card" content="summary" />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet" />
<script type="application/ld+json" set:html={JSON.stringify(person)} />
<script is:inline>
(() => {
  try {
    const theme = JSON.parse(localStorage.getItem('subham-site-theme-v1') || 'null');
    if (!theme) return;
    const root = document.documentElement;
    const vars = { paper:'--paper',surface:'--surface',surfaceSoft:'--surface-soft',ink:'--ink',muted:'--muted',green:'--green',greenDark:'--green-dark',lime:'--lime' };
    for (const [key, cssName] of Object.entries(vars)) if (theme[key]) root.style.setProperty(cssName, theme[key]);
    if (theme.display) root.style.setProperty('--display', '"' + theme.display + '", Georgia, serif');
    if (theme.sans) root.style.setProperty('--sans', '"' + theme.sans + '", ui-sans-serif, system-ui, sans-serif');
    if (theme.radius) root.style.setProperty('--theme-radius', theme.radius);
    const extra = {
      bodyWeight: '--body-weight', headingWeight: '--heading-weight', headingScale: '--heading-scale',
      lineHeight: '--line-height', sectionSpacing: '--section-spacing'
    };
    for (const [key, cssName] of Object.entries(extra)) if (theme[key]) root.style.setProperty(cssName, theme[key]);
    if (theme.bodySize) root.style.setProperty('--body-size', theme.bodySize + 'px');
    if (theme.letterSpacing !== undefined) root.style.setProperty('--letter-spacing', theme.letterSpacing + 'px');
    if (theme.contentWidth) root.style.setProperty('--content-width', theme.contentWidth + 'px');
    if (theme.shadow) root.style.setProperty('--card-shadow', theme.shadow === 'none' ? 'none' : theme.shadow === 'strong' ? '0 18px 45px rgb(20 40 25 / 14%)' : '0 8px 24px rgb(20 40 25 / 7%)');
    if (theme.buttonStyle) root.style.setProperty('--button-radius', theme.buttonStyle === 'pill' ? '999px' : theme.buttonStyle === 'square' ? '2px' : '7px');
    const fontUrl = name => name === 'Georgia' || name === 'Arial' || name === 'system-ui' ? null : 'https://fonts.googleapis.com/css2?family=' + encodeURIComponent(name).replace(/%20/g, '+') + ':wght@300;400;500;600;700;800;900&display=swap';
    const urls = [fontUrl(theme.display), fontUrl(theme.sans)].filter(Boolean);
    if (urls.length) {
      let link = document.getElementById('theme-google-fonts');
      if (!link) { link = document.createElement('link'); link.id = 'theme-google-fonts'; link.rel = 'stylesheet'; document.head.appendChild(link); }
      link.href = urls.join('&family=');
    }
  } catch {}
})();
</script>
</head><body><slot /></body></html>
