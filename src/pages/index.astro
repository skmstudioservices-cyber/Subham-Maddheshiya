---
import Base from '../layouts/Base.astro';
import '../styles/global.css';

const projects = [
  {
    number: '01',
    type: 'DATA DIRECTORY',
    name: 'Digital Pincode',
    description: 'Making India’s postal and location information easier to find, understand, and use.',
    tags: ['India data', 'Local search', 'SEO'],
    status: 'Building',
  },
  {
    number: '02',
    type: 'LOCAL DISCOVERY',
    name: 'Near Me Network',
    description: 'A collection of focused location tools designed to help people find useful places nearby.',
    tags: ['Discovery', 'Utility', 'Directories'],
    status: 'Expanding',
  },
  {
    number: '03',
    type: 'WEB PRODUCTS',
    name: 'SKM Studio',
    description: 'The home for practical web products, experiments, and data-led digital experiences.',
    tags: ['Product development', 'Web', 'Research'],
    status: 'Active',
  },
];
---
<Base title="Subham Maddheshiya — Independent Web Product Builder" description="I build useful, lightweight web products that make public information easier to find. Explore independent projects from Subham Maddheshiya and SKM Studio.">
  <section class="hero shell">
    <div class="hero-copy">
      <div class="eyebrow"><span class="status-dot"></span> INDEPENDENT BUILDER · INDIA</div>
      <h1>Useful things for the <span class="accent-text">open web.</span></h1>
      <p class="hero-lede">I turn messy information and everyday problems into simple, fast websites people can actually use.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↘</span></a>
        <a class="text-link" href="mailto:skmstudio.services@gmail.com">Get in touch <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-meta"><span>Based in India</span><span class="meta-divider"></span><span>Building independently at SKM Studio</span></div>
    </div>
    <div class="hero-art" aria-label="Abstract illustration representing connected data and web products">
      <div class="art-orbit orbit-one"></div>
      <div class="art-orbit orbit-two"></div>
      <div class="art-core"><span>SKM</span><small>STUDIO NETWORK</small></div>
      <div class="art-node node-a">DATA</div>
      <div class="art-node node-b">TOOLS</div>
      <div class="art-node node-c">WEB</div>
      <div class="art-caption">Ideas → useful products</div>
    </div>
  </section>

  <section class="intro shell">
    <div class="section-kicker">01 / THE APPROACH</div>
    <div class="intro-content">
      <h2>Build for real needs.<br /><span class="soft-text">Keep it simple.</span></h2>
      <p>I’m an independent digital builder working across search, content, web design, and lightweight development. My focus is practical: make useful information easier to access, especially on the Indian web and on everyday devices.</p>
    </div>
  </section>

  <section class="work-section" id="work">
    <div class="shell">
      <div class="section-heading">
        <div><div class="section-kicker">02 / SELECTED WORK</div><h2>Things in progress<span class="accent-text">.</span></h2></div>
        <p>A growing set of independent products and experiments under the SKM Studio umbrella.</p>
      </div>
      <div class="project-grid">
        {projects.map((project) => (
          <article class="project-card">
            <div class="project-top"><span>{project.number} / {project.type}</span><span class="project-status"><i></i>{project.status}</span></div>
            <div class="project-visual" aria-hidden="true">
              {project.number === '01' ? <div class="visual-map"><span class="map-line line-a"></span><span class="map-line line-b"></span><span class="map-pin pin-a"></span><span class="map-pin pin-b"></span><span class="map-pin pin-c"></span><span class="map-label">IN / 000</span></div> : project.number === '02' ? <div class="visual-radar"><span></span><span></span><span></span><b>NEAR<br/>YOU</b></div> : <div class="visual-stack"><span>01&nbsp; / &nbsp;IDEA</span><span>02&nbsp; / &nbsp;BUILD</span><span>03&nbsp; / &nbsp;SHIP</span></div>}
            </div>
            <div class="project-body"><h3>{project.name}</h3><p>{project.description}</p><div class="tag-row">{project.tags.map(tag => <span>{tag}</span>)}</div></div>
          </article>
        ))}
      </div>
      <div class="work-footnote"><span class="status-dot"></span> More experiments are being built and shipped over time.</div>
    </div>
  </section>

  <section class="principles shell">
    <div class="section-kicker">03 / HOW I WORK</div>
    <div class="principle-grid">
      <article><span class="principle-no">01</span><h3>Start with the problem</h3><p>Understand what people are trying to do before adding features or complexity.</p></article>
      <article><span class="principle-no">02</span><h3>Make it lightweight</h3><p>Prefer fast pages, accessible interfaces, and tools that work on ordinary devices.</p></article>
      <article><span class="principle-no">03</span><h3>Improve with evidence</h3><p>Use search data, real usage, and feedback to decide what deserves the next iteration.</p></article>
    </div>
  </section>

  <section class="contact shell" id="contact">
    <div class="contact-panel">
      <div><div class="section-kicker">04 / CONTACT</div><h2>Have a useful problem<br/>to solve?</h2><p>For collaborations, project ideas, or digital work, send me a note.</p></div>
      <a class="button button-light" href="mailto:skmstudio.services@gmail.com">Start a conversation <span aria-hidden="true">↗</span></a>
    </div>
  </section>
</Base>
