---
interface Props { number: string; category: string; title: string; description: string; tags: string[]; href: string; visual: 'map'|'radar'|'stack'; status?: string; }
const { number, category, title, description, tags, href, visual, status = 'In development' } = Astro.props;
---
<article class="project-card"><div class="project-top"><span>{number} / {category}</span><span class="project-status"><i></i>{status}</span></div><div class="project-visual" aria-hidden="true">{visual === 'map' ? <div class="visual-map"><span class="map-line line-a"></span><span class="map-line line-b"></span><i class="map-pin pin-a"></i><i class="map-pin pin-b"></i><i class="map-pin pin-c"></i><small class="map-label">INDIA · LOCAL DATA</small></div> : visual === 'radar' ? <div class="visual-radar"><span></span><span></span><span></span><b>NEAR<br/>YOU</b></div> : <div class="visual-stack"><span>DISCOVER</span><span>UNDERSTAND</span><span>TAKE ACTION</span></div>}</div><div class="project-body"><h3>{title}</h3><p>{description}</p><div class="tag-row">{tags.map(tag => <span>{tag}</span>)}</div><a class="project-link" href={href} target="_blank" rel="noopener noreferrer">Explore project <span aria-hidden="true">↗</span></a></div></article>